<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <Version>0.0.0-placeholder</Version>
        <Deterministic>true</Deterministic>

        <PackageId>DbLive.MSSQL</PackageId>
        <Authors>ZACoders</Authors>
        <Company>DbLive</Company>
        <Description>Database Deployment and Testing Framework for MSSQL and .NET</Description>

        <PackageProjectUrl>https://github.com/zacoders/DbLive</PackageProjectUrl>
        <RepositoryUrl>https://github.com/zacoders/DbLive</RepositoryUrl>
        <RepositoryType>git</RepositoryType>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>sql mssql sqlserver sql-server database deployment migration rollback testing devops cicd db-deployment sql-deployment</PackageTags>
		<PackageIcon>dblive-icon.png</PackageIcon>
	</PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SqlServer.SqlManagementObjects" />
		<PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<!-- Tracks the public API in PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt: see "The public API" in Development.md. -->
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
        <PackageReference Include="Microsoft.Data.SqlClient" />
        <!-- Pins a transitive dependency of Microsoft.Data.SqlClient to a patched version (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx).
             Remove once Microsoft.Data.SqlClient references a fixed version. -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" />
        <PackageReference Include="Dapper" />
    </ItemGroup>
  
	<!-- DbLive's own scripts (the dblive schema), read by the self-deployer from this assembly. -->
	<ItemGroup>
		<EmbeddedResource Include="SQL\**\*.sql" LogicalName="DbLive.Internal/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
	</ItemGroup>
	
    <ItemGroup>
	    <ProjectReference Include="..\DbLive\DbLive.csproj" />
    </ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="DbLive.MSSQL.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\dblive-icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="README.md" Pack="true" PackagePath="/" />
	</ItemGroup>

</Project>
