<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<NoWarn>IDE0058</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbLive.Tests.Common\DbLive.Tests.Common.csproj" />
    <ProjectReference Include="..\DbLive.xunit\DbLive.xunit.csproj" />
  </ItemGroup>

  <!-- The demos are loaded from their dll and from their source folder by EmbeddedScriptsParityTests. -->
  <ItemGroup>
    <ProjectReference Include="..\Demo\AdventureWorks\AdventureWorks.Database\AdventureWorks.Database.csproj" />
    <ProjectReference Include="..\Demo\Demo.PostgreSQL.Chinook\Demo.PostgreSQL.Chinook.csproj" />
    <ProjectReference Include="..\Demo\DemoMSSQL\DemoMSSQL.csproj" />
    <ProjectReference Include="..\Demo\DemoMSSQLEmpty\DemoMSSQLEmpty.csproj" />
  </ItemGroup>

  <!-- InternalScriptsTests compare DbLive's own scripts embedded in the providers with their SQL folders. -->
  <ItemGroup>
    <ProjectReference Include="..\DbLive.MSSQL\DbLive.MSSQL.csproj" />
    <ProjectReference Include="..\DbLive.PostgreSQL\DbLive.PostgreSQL.csproj" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadata">
      <_Parameter1>SrcDir</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- This assembly is also a SQL project, without the ProjectDir metadata. -->
  <ItemGroup>
    <EmbeddedResource Include="Scripts\**\*" LogicalName="DbLive/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverageAttribute" />
  </ItemGroup>
  
</Project>
