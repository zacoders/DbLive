{
  // Project settings. A migration, breaking or undo script can override the transaction
  // settings in its own <version>.<item>.settings.json.

  // Optional. Binds this project to a database; max 128 characters.
  "ProjectId": "adventureworks",

  /* Options:
      Deployment - the whole deployment in one transaction
      Migration - each migration, breaking and undo script in its own transaction
      None - no transactions */
  "TransactionWrapLevel": "Migration",

  /* Options:
      ReadCommitted,
      RepeatableRead,
      Serializable,
      Snapshot (MSSQL only; requires ALLOW_SNAPSHOT_ISOLATION ON) */
  "TransactionIsolationLevel": "Serializable",

  /* Parallel code deploy is forced to serial when TransactionWrapLevel is Deployment. */

  /* Files in Code that match these patterns are SQL tests, not code objects.
     A deployment never runs the tests; AdventureWorks.Tests runs them. */
  "TestFilePatterns": [ "test.*.sql", "t.*.sql", "*.test.sql", "*.t.sql" ],

  "CodeSubFoldersDeploymentOrder": [
    "Views",
    "Triggers",
    "Functions"
  ],

  /* MigrationChecksumMode: Strict (default) | Warn */
  "MigrationChecksumMode": "Strict"
}
