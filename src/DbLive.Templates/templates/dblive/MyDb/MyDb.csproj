<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The DbLive package embeds this folder in the assembly when the project builds. -->
    <DbLiveScriptsFolder>Scripts</DbLiveScriptsFolder>
  </PropertyGroup>

  <!-- The provider brings the DbLive package. -->
  <ItemGroup>
    <!--#if (mssql) -->
    <PackageReference Include="DbLive.MSSQL" Version="DBLIVE_VERSION" />
    <!--#else -->
    <PackageReference Include="DbLive.PostgreSQL" Version="DBLIVE_VERSION" />
    <!--#endif -->
  </ItemGroup>

</Project>
